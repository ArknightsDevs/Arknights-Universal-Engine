# The @aue packages are never fetched from a registry: inside this repository they are workspace packages, elsewhere
# they come from git (github:ArknightsDevs/Arknights-Universal-Engine#<tag>&path:/packages/<name>). Pointing the scope at a
# reserved, unresolvable host makes an accidental registry lookup fail instead of installing someone else's package.
@aue:registry=https://registry.aue.invalid/
engine-strict=true
