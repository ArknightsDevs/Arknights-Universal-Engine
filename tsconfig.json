{
  // JavaScript with JSDoc types, checked strictly (ADR: type checking). Nothing is emitted: the sources are what runs
  // in browsers, workers and Node.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.js", "packages/*/test/**/*.js", "eslint.config.js"],
  "exclude": ["**/node_modules"]
}
